VITE_USE_MOCK_API=true

# Only needed when VITE_USE_MOCK_API is false. See "docs/apps script setup.md".
VITE_APPS_SCRIPT_URL=
VITE_GOOGLE_CLIENT_ID=

# Backend is the default; override when needed.
VITE_COMPETITION_API_URL=

# Set to true only if you explicitly want the Google Sheets fallback.
VITE_USE_SHEETS_API=false
