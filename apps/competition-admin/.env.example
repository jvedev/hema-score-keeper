# Base URL of the backend API. Defaults to /api/v1 for the one-origin deployment.
VITE_COMPETITION_API_URL=
# Where the participant app lives, without a trailing slash; invite links are <this>/join/<code>.
# Defaults to the same origin at /hema-score-keeper/competition in production.
VITE_PARTICIPANT_APP_URL=
# Where the score-keeper app lives, without a trailing slash; ring links are <this>/ring/<token>.
# Defaults to the same origin at /score-keeper in production; override for a separately hosted app.
# In development it defaults to http://localhost:5180/score-keeper.
VITE_SCORE_KEEPER_URL=
