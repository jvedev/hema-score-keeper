# Base URL of the backend API. Defaults to /api/v1, which the dev server proxies to http://localhost:3001.
VITE_COMPETITION_API_URL=
# Where the participant app lives, without a trailing slash; invite links are <this>/join/<code>.
# Defaults to http://localhost:5173/hema-score-keeper/competition in dev, and to
# <this site's origin>/hema-score-keeper/competition in a build.
VITE_PARTICIPANT_APP_URL=
# Where the score-keeper app lives, without a trailing slash; ring links are <this>/ring/<token>.
# The score-keeper has no base path, so its ring page is at the root of its site.
# Defaults to http://localhost:5180 (the score-keeper dev server) in dev. Production builds MUST set it:
# the score-keeper is hosted apart from the admin app, so the admin origin is the wrong guess.
VITE_SCORE_KEEPER_URL=
