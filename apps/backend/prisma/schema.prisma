generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  username             String                @unique
  judgeVolunteer       Boolean               @default(false)
  juryVolunteer        Boolean               @default(false)
  tableVolunteer       Boolean               @default(false)
  otherVolunteer       Boolean               @default(false)
  entries              Entry[]
  scheduledAssignments ScheduledAssignment[]
  skills               Skill[]
}

model Skill {
  id         String @id @default(cuid())
  userId     String
  skillName  String
  skillLevel Int
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Event {
  id                       String         @id @default(cuid())
  eventName                String
  rulesetId                String?
  allFightersAreVolunteers Boolean        @default(false)
  arenas                   Arena[]
  ruleset                  Ruleset?       @relation("EventDefaultRuleset", fields: [rulesetId], references: [id])
  schedule                 EventSchedule?
  rulesets                 Ruleset[]      @relation("EventRulesets")
  tournaments              Tournament[]
}

model EventSchedule {
  id               String             @id @default(cuid())
  eventId          String             @unique
  startTimeMinutes Int                @default(540)
  event            Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  timeSlots        ScheduleTimeSlot[]
}

model ScheduleTimeSlot {
  id              String           @id @default(cuid())
  scheduleId      String
  order           Int
  durationMinutes Int
  label           String
  color           String?
  isBreak         Boolean          @default(false)
  schedule        EventSchedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduledPhases ScheduledPhase[]

  @@unique([scheduleId, order])
  @@index([scheduleId])
}

model Tournament {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  rulesetId String?
  order     Int      @default(0)
  color     String   @default("#5B8CFF")
  entries   Entry[]
  stages    Stage[]
  ruleset   Ruleset? @relation(fields: [rulesetId], references: [id])
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Entry {
  id              String          @id @default(cuid())
  tournamentId    String
  userId          String
  kind            EntryKind       @default(FIGHTER)
  seed            Int?
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament      Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matchesAsWinner Match[]         @relation("MatchWinner")
  matchesAsB      Match[]         @relation("MatchEntryB")
  matchesAsA      Match[]         @relation("MatchEntryA")
  stageOfficials  StageOfficial[]

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
}

model Arena {
  id              String           @id @default(cuid())
  eventId         String
  name            String
  order           Int              @default(0)
  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  matches         Match[]
  scheduledPhases ScheduledPhase[]
  stages          StageArena[]

  @@index([eventId])
}

model Stage {
  id                          String           @id @default(cuid())
  tournamentId                String
  type                        StageType
  name                        String?
  rulesetId                   String?
  minPoolSize                 Int?
  maxPoolSize                 Int?
  preferredPoolSize           Int?
  eliminationParticipantCount Int?
  timeBetweenMatchesMinutes   Int              @default(2)
  rounds                      Round[]
  scheduledPhases             ScheduledPhase[]
  ruleset                     Ruleset?         @relation(fields: [rulesetId], references: [id])
  tournament                  Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  arenas                      StageArena[]
  officials                   StageOfficial[]

  @@index([tournamentId])
}

model ScheduledPhase {
  id          String                @id @default(cuid())
  stageId     String
  arenaId     String
  timeSlotId  String
  assignments ScheduledAssignment[]
  timeSlot    ScheduleTimeSlot      @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  arena       Arena                 @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  stage       Stage                 @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([arenaId, timeSlotId])
  @@unique([stageId, arenaId, timeSlotId])
  @@index([stageId])
  @@index([timeSlotId])
}

model ScheduledAssignment {
  id               String         @id @default(cuid())
  scheduledPhaseId String
  userId           String
  role             ScheduleRole
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledPhase   ScheduledPhase @relation(fields: [scheduledPhaseId], references: [id], onDelete: Cascade)

  @@unique([scheduledPhaseId, userId])
  @@index([userId])
}

model StageArena {
  id      String @id @default(cuid())
  stageId String
  arenaId String
  arena   Arena  @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  stage   Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, arenaId])
  @@index([stageId])
  @@index([arenaId])
}

model StageOfficial {
  id      String            @id @default(cuid())
  stageId String
  entryId String
  role    StageOfficialRole
  entry   Entry             @relation(fields: [entryId], references: [id], onDelete: Cascade)
  stage   Stage             @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, entryId, role])
  @@index([stageId])
  @@index([entryId])
}

model Round {
  id          String  @id @default(cuid())
  stageId     String
  roundNumber Int
  matches     Match[]
  stage       Stage   @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, roundNumber])
  @@index([stageId])
}

model Match {
  id            String     @id @default(cuid())
  roundId       String
  arenaId       String?
  entryAId      String?
  entryBId      String?
  winnerEntryId String?
  scoreA        Int?
  scoreB        Int?
  rulesetId     String?
  exchanges     Exchange[]
  ruleset       Ruleset?   @relation(fields: [rulesetId], references: [id])
  winnerEntry   Entry?     @relation("MatchWinner", fields: [winnerEntryId], references: [id])
  entryB        Entry?     @relation("MatchEntryB", fields: [entryBId], references: [id])
  entryA        Entry?     @relation("MatchEntryA", fields: [entryAId], references: [id])
  arena         Arena?     @relation(fields: [arenaId], references: [id])
  round         Round      @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@index([arenaId])
}

model Ruleset {
  id              String               @id @default(cuid())
  eventId         String
  name            String
  version         Int                  @default(1)
  definition      Json?
  defaultedEvents Event[]              @relation("EventDefaultRuleset")
  matches         Match[]
  event           Event                @relation("EventRulesets", fields: [eventId], references: [id], onDelete: Cascade)
  stages          Stage[]
  tournaments     Tournament[]

  @@unique([eventId, name, version])
  @@index([eventId])
  @@index([eventId, name])
}

model Exchange {
  id      String @id @default(cuid())
  matchId String
  scoreA  Int?
  scoreB  Int?
  details Json?
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

enum StageType {
  POOL
  ELIMINATION
  SEMI_FINAL
  FINAL
}

enum EntryKind {
  FIGHTER
  VOLUNTEER
  BOTH
}

enum StageOfficialRole {
  JUDGE
  JURY
  TELLER
  TABLE
}

enum ScheduleRole {
  JUDGE
  JURY
  TABLE
  FIGHTER
}
