generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(cuid())
  username String  @unique
  skills   Skill[]
  entries  Entry[]
  scheduledAssignments ScheduledAssignment[]
}

model Skill {
  id         String @id @default(cuid())
  userId     String
  skillName  String
  skillLevel Int
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Event {
  id                       String       @id @default(cuid())
  eventName                String
  ruleset                  String?
  allFightersAreVolunteers Boolean      @default(false)
  tournaments              Tournament[]
  arenas                   Arena[]
  schedule                 EventSchedule?
}

model EventSchedule {
  id               String             @id @default(cuid())
  eventId          String             @unique
  startTimeMinutes Int                @default(540)
  event            Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  timeSlots        ScheduleTimeSlot[]
}

model ScheduleTimeSlot {
  id              String           @id @default(cuid())
  scheduleId      String
  order           Int
  durationMinutes Int
  label           String
  color           String?
  isBreak         Boolean          @default(false)
  schedule        EventSchedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduledPhases ScheduledPhase[]

  @@unique([scheduleId, order])
  @@index([scheduleId])
}

model Tournament {
  id         String   @id @default(cuid())
  eventId    String
  name       String
  ruleset    String?
  order      Int      @default(0)
  color      String   @default("#5B8CFF")
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entries    Entry[]
  stages     Stage[]

  @@index([eventId])
}

model Entry {
  id              String    @id @default(cuid())
  tournamentId    String
  userId          String
  kind            EntryKind @default(FIGHTER)
  seed            Int?
  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchesAsA      Match[] @relation("MatchEntryA")
  matchesAsB      Match[] @relation("MatchEntryB")
  matchesAsWinner Match[] @relation("MatchWinner")
  stageOfficials  StageOfficial[]

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
}

model Arena {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  order     Int      @default(0)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stages    StageArena[]
  matches   Match[]
  scheduledPhases ScheduledPhase[]

  @@index([eventId])
}

model Stage {
  id          String   @id @default(cuid())
  tournamentId String
  type        StageType
  name        String?
  ruleset     String?
  tournament  Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  rounds      Round[]
  arenas      StageArena[]
  officials   StageOfficial[]
  scheduledPhases ScheduledPhase[]

  @@index([tournamentId])
}

model ScheduledPhase {
  id         String           @id @default(cuid())
  stageId    String
  arenaId    String
  timeSlotId String
  stage      Stage            @relation(fields: [stageId], references: [id], onDelete: Cascade)
  arena      Arena            @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  timeSlot   ScheduleTimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  assignments ScheduledAssignment[]

  @@unique([arenaId, timeSlotId])
  @@unique([stageId, arenaId, timeSlotId])
  @@index([stageId])
  @@index([timeSlotId])
}

model ScheduledAssignment {
  id               String         @id @default(cuid())
  scheduledPhaseId String
  userId           String
  role             ScheduleRole
  scheduledPhase   ScheduledPhase @relation(fields: [scheduledPhaseId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scheduledPhaseId, userId])
  @@index([userId])
}

model StageArena {
  id       String @id @default(cuid())
  stageId  String
  arenaId  String
  stage    Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  arena    Arena  @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  @@unique([stageId, arenaId])
  @@index([stageId])
  @@index([arenaId])
}

model StageOfficial {
  id      String @id @default(cuid())
  stageId String
  entryId String
  role    StageOfficialRole
  stage   Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([stageId, entryId, role])
  @@index([stageId])
  @@index([entryId])
}

model Round {
  id          String  @id @default(cuid())
  stageId     String
  roundNumber Int
  stage       Stage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  matches     Match[]

  @@unique([stageId, roundNumber])
  @@index([stageId])
}

model Match {
  id            String   @id @default(cuid())
  roundId       String
  arenaId       String?
  entryAId      String?
  entryBId      String?
  winnerEntryId String?
  scoreA        Int?
  scoreB        Int?
  ruleset       String?
  round         Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  arena         Arena?   @relation(fields: [arenaId], references: [id], onDelete: SetNull)
  entryA        Entry?   @relation("MatchEntryA", fields: [entryAId], references: [id], onDelete: SetNull)
  entryB        Entry?   @relation("MatchEntryB", fields: [entryBId], references: [id], onDelete: SetNull)
  winnerEntry   Entry?   @relation("MatchWinner", fields: [winnerEntryId], references: [id], onDelete: SetNull)
  exchanges     Exchange[]

  @@index([roundId])
  @@index([arenaId])
}

model Exchange {
  id      String @id @default(cuid())
  matchId String
  scoreA  Int?
  scoreB  Int?
  details Json?
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

enum StageType {
  POOL
  ELIMINATION
  SEMI_FINAL
  FINAL
}

enum EntryKind {
  FIGHTER
  VOLUNTEER
  BOTH
}

enum StageOfficialRole {
  JUDGE
  JURY
  TELLER
  TABLE
}

enum ScheduleRole {
  JUDGE
  JURY
  TABLE
}
