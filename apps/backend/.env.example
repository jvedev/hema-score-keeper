# Local development database. Relative file paths resolve under APP_DATA_DIR when set.
DATABASE_URL="file:./dev.db"
# Optional stable data root for deployments; keep it outside replaceable release files.
APP_DATA_DIR=
# Optional live workbook directory. Defaults to <APP_DATA_DIR>/live.
LIVE_DATA_DIR=

# Alwaysdata provides IP and PORT to a Node.js site; the server uses those values automatically.
# Never commit AUTH_SECRET. Use a long random value and keep it stable between restarts/deployments.
AUTH_SECRET=
# Optional separate pepper for email hashes. Keep it stable if configured.
AUTH_EMAIL_PEPPER=

# Service account used to read/write the club's Google Sheets. The club shares
# each tournament's sheets with this account's email; the app never asks a
# volunteer to sign into their own Google account.
# See "docs/google sheets setup.md" for how to create these.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional Web Push for on-deck alerts. Generate once with `npx web-push generate-vapid-keys`.
# Keep the private key secret and stable; rotating the pair requires users to subscribe again.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.org
COMPETITION_PWA_BASE_PATH=/hema-score-keeper/competition/
