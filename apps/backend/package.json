{
  "name": "@hema/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node dist/server.js",
    "build": "npm run build --workspace @hema/ranking && npm run build --workspace @hema/competition-domain && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:env": "node --env-file=.env dist/server.js",
    "db:seed": "node ./scripts/seed-database.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hema/competition-domain": "*",
    "@hema/ranking": "*",
    "better-sqlite3": "^12.4.1",
    "exceljs": "4.4.0",
    "fastify": "^5.6.0",
    "kysely": "^0.28.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
