{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "competition-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "@hema/competition"
      ],
      "port": 5173,
      "url": "http://localhost:5173"
    },
    {
      "name": "ui-storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "storybook",
        "--workspace",
        "@hema/ui",
        "--",
        "--no-open"
      ],
      "port": 6006
    },
    {
      "name": "score-keeper-live",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "@hema/score-keeper",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180,
      "env": {
        "VITE_USE_MOCK_API": "false"
      }
    },
    {
      "name": "competition-admin-live",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "@hema/competition-admin",
        "--",
        "--port",
        "5181",
        "--strictPort"
      ],
      "port": 5181
    }
  ]
}
