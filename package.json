{
  "name": "hema-score-keeper",
  "version": "0.1.0",
  "private": true,
  "description": "HEMA score keeping monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @hema/score-keeper",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "storybook": "npm run storybook --workspace @hema/ui"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "packageManager": "npm@11.6.2",
  "devDependencies": {
    "@types/node": "^26.1.2"
  }
}
