{
  "name": "hema-score-keeper",
  "version": "0.1.0",
  "private": true,
  "description": "HEMA score keeping monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "score-keeper:dev": "npm run dev --workspace @hema/score-keeper",
    "admin:dev": "npm run dev --workspace @hema/tournament-admin",
    "admin:build": "npm run build --workspace @hema/tournament-admin",
    "admin:typecheck": "npm run typecheck --workspace @hema/tournament-admin",
    "event-admin:dev": "npm run dev --workspace @hema/event-admin",
    "event-admin:build": "npm run build --workspace @hema/event-admin",
    "event-admin:typecheck": "npm run typecheck --workspace @hema/event-admin",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "storybook": "npm run storybook --workspace @hema/ui",
    "backend:dev": "npm run dev --workspace @hema/backend",
    "backend:build": "npm run build --workspace @hema/backend",
    "backend:db:seed": "npm run db:seed --workspace @hema/backend"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "packageManager": "npm@11.6.2",
  "devDependencies": {
    "@types/node": "^26.1.2"
  }
}
